<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'id' %>">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('customer.dashboard_title', 'Dashboard Pelanggan') %> | Portal ISP</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="manifest" href="/manifest.webmanifest">
  <meta name="theme-color" content="#f8fafc">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <link rel="apple-touch-icon" href="/img/logo.png">
  <link rel="icon" href="/img/logo.png">
  <style>
    :root {
      --bg-page: #f8fafc;
      --card-bg: #ffffff;
      --card-border: #e2e8f0;
      --text-main: #0f172a;
      --text-muted: #64748b;
      --accent: #2563eb;
      --accent-soft: #eff6ff;
    }

    body {
      background: var(--bg-page);
      color: var(--text-main);
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      min-height: 100vh;
      padding-bottom: 80px; /* Space for bottom nav */
      -webkit-tap-highlight-color: transparent;
    }

    .navbar {
      background: #ffffff !important;
      border-bottom: 1px solid var(--card-border);
    }

    .navbar-brand {
      font-weight: 700;
      color: var(--text-main) !important;
      font-size: 17px;
    }

    .navbar-brand img {
      height: 38px;
      max-width: 76px;
      border-radius: 8px;
    }

    .pelanggan-area {
      font-size: 14px;
      color: var(--text-muted);
      font-weight: 500;
    }

    .pelanggan-area strong { color: var(--text-main); }

    .btn-logout {
      border: 1px solid #fecaca;
      color: #dc2626;
      background: #fff;
      border-radius: 10px;
      font-size: 13px;
      font-weight: 600;
      padding: 7px 14px;
      transition: all .2s ease;
    }

    .btn-logout:hover { background: #fef2f2; color: #b91c1c; border-color: #fca5a5; }

    .main-container { padding: 20px 0; }

    .card {
      border: 1px solid var(--card-border);
      border-radius: 16px;
      background: var(--card-bg);
      box-shadow: 0 1px 3px rgba(15, 23, 42, 0.06);
      transition: box-shadow .2s ease;
      overflow: hidden;
    }

    .card:hover { box-shadow: 0 4px 14px rgba(15, 23, 42, 0.08); }

    .card-header {
      background: #ffffff;
      color: var(--text-main);
      border: none;
      padding: 16px 20px;
      border-bottom: 1px solid #f1f5f9;
      font-weight: 700;
      font-size: 15px;
    }

    .card-header i { color: var(--accent); }

    .card-body { padding: 20px; }

    /* ===== 4 Summary stat cards ===== */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 14px;
      margin-bottom: 20px;
    }

    @media (max-width: 991.98px) {
      .stats-grid { grid-template-columns: repeat(2, 1fr); }
    }

    .stat-card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 14px;
      padding: 16px;
      box-shadow: 0 1px 3px rgba(15, 23, 42, 0.06);
    }

    .stat-label {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .5px;
      color: var(--text-muted);
      margin-bottom: 6px;
    }

    .stat-value {
      font-size: 16px;
      font-weight: 700;
      color: var(--text-main);
      word-break: break-word;
    }

    .stat-sub { font-size: 12px; color: var(--text-muted); margin-top: 4px; }

    .badge-soft-success { background: #dcfce7; color: #15803d; font-weight: 600; }
    .badge-soft-danger { background: #fee2e2; color: #b91c1c; font-weight: 600; }
    .badge-soft-secondary { background: #f1f5f9; color: #475569; font-weight: 600; }
    .badge-soft-warning { background: #fef3c7; color: #b45309; font-weight: 600; }

    /* ===== Info ONT rows ===== */
    .info-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      padding: 10px 0;
      border-bottom: 1px dashed #f1f5f9;
      font-size: 14px;
    }

    .info-row:last-child { border-bottom: none; }
    .info-row .k { color: var(--text-muted); font-weight: 500; }
    .info-row .v { font-weight: 600; text-align: right; word-break: break-all; }

    /* ===== Traffic gauges ===== */
    .traffic-wrap {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
      margin-top: 14px;
    }

    @media (max-width: 575.98px) {
      .traffic-wrap { grid-template-columns: 1fr; }
    }

    .traffic-box {
      background: #f8fafc;
      border: 1px solid #eef2f7;
      border-radius: 12px;
      padding: 12px;
      text-align: center;
    }

    .traffic-gauge { position: relative; width: 100%; max-width: 240px; margin: 0 auto; }
    .traffic-gauge canvas { width: 100%; height: auto; display: block; }

    .traffic-gauge-center {
      position: absolute;
      left: 0; right: 0;
      bottom: 22%;
      text-align: center;
      pointer-events: none;
    }

    .traffic-gauge-value { font-size: 22px; font-weight: 800; color: var(--text-main); line-height: 1; }
    .traffic-gauge-unit { font-size: 11px; font-weight: 600; color: var(--text-muted); margin-top: 2px; }

    .traffic-gauge-scale {
      display: flex;
      justify-content: space-between;
      font-size: 10px;
      color: var(--text-muted);
      padding: 0 8px;
    }

    /* ===== Device list ===== */
    .device-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 11px 0;
      border-bottom: 1px dashed #f1f5f9;
    }

    .device-item:last-child { border-bottom: none; }

    .device-icon {
      width: 38px; height: 38px;
      border-radius: 10px;
      background: var(--accent-soft);
      color: var(--accent);
      display: flex; align-items: center; justify-content: center;
      font-size: 17px;
      flex-shrink: 0;
    }

    .device-meta { flex-grow: 1; min-width: 0; }
    .device-host { font-weight: 600; font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .device-sub { font-size: 12px; color: var(--text-muted); }

    /* ===== Forms ===== */
    .form-label { font-size: 13px; font-weight: 600; color: var(--text-main); }

    .form-control, .form-select {
      border-radius: 10px;
      border: 1px solid #cbd5e1;
      font-size: 14px;
      padding: 10px 13px;
    }

    .form-control:focus, .form-select:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
    }

    .btn-update {
      background: var(--accent);
      border: none;
      color: #fff;
      border-radius: 10px;
      font-weight: 600;
      padding: 10px 18px;
      transition: background .2s ease;
    }

    .btn-update:hover { background: #1d4ed8; color: #fff; }

    .pass-toggle {
      border: 1px solid #cbd5e1;
      border-left: none;
      background: #fff;
      color: var(--text-muted);
      border-radius: 0 10px 10px 0;
    }

    .pass-toggle:hover { color: var(--text-main); }

    .input-group .form-control { border-radius: 10px 0 0 10px; }

    /* ===== Control buttons ===== */
    .ctrl-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
    }

    @media (max-width: 575.98px) {
      .ctrl-grid { grid-template-columns: 1fr; }
    }

    .ctrl-btn {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
      padding: 14px 8px;
      border-radius: 12px;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: .3px;
      border: 1px solid var(--card-border);
      background: #f8fafc;
      color: var(--text-main);
      transition: all .2s ease;
      width: 100%;
    }

    .ctrl-btn i { font-size: 20px; }
    .ctrl-btn:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(15,23,42,.08); }

    .ctrl-btn.danger { color: #dc2626; border-color: #fecaca; background: #fef2f2; }
    .ctrl-btn.danger:hover { background: #fee2e2; }
    .ctrl-btn.primary { color: #1d4ed8; border-color: #bfdbfe; background: #eff6ff; }
    .ctrl-btn.primary:hover { background: #dbeafe; }
    .ctrl-btn.warning { color: #b45309; border-color: #fde68a; background: #fffbeb; }
    .ctrl-btn.warning:hover { background: #fef3c7; }

    /* ===== Tables ===== */
    .table { font-size: 14px; color: var(--text-main); }
    .table > :not(caption) > * > * { background: transparent; color: inherit; border-bottom-color: #f1f5f9; }
    .table thead th { font-size: 11px; text-transform: uppercase; letter-spacing: .5px; color: var(--text-muted); font-weight: 700; }

    /* ===== Alerts (light) ===== */
    .alert-lunas { background: #f0fdf4; border: 1px solid #bbf7d0; color: #166534; border-radius: 12px; }
    .alert-unpaid { background: #fffbeb; border: 1px solid #fde68a; color: #92400e; border-radius: 12px; }
    .alert-netral { background: #f8fafc; border: 1px solid #e2e8f0; color: #475569; border-radius: 12px; }

    /* ===== Pay cards ===== */
    .pay-card {
      background: #f8fafc;
      border: 1px solid var(--card-border);
      border-radius: 14px;
      padding: 16px;
    }

    .btn-bayar {
      background: var(--accent);
      color: #fff;
      border: none;
      border-radius: 10px;
      font-weight: 600;
      padding: 10px 14px;
      width: 100%;
      transition: background .2s ease;
    }

    .btn-bayar:hover { background: #1d4ed8; color: #fff; }

    /* ===== Payment modal (light) ===== */
    .modal-content.pay-modal {
      background: #ffffff;
      border: 1px solid var(--card-border);
      border-radius: 18px;
      box-shadow: 0 22px 70px rgba(15, 23, 42, 0.25);
    }

    .payment-methods-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
    }

    @media (max-width: 390px) {
      .payment-methods-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }

    .pay-method-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 14px;
      background: #f8fafc;
      border: 1px solid var(--card-border);
      border-radius: 14px;
      cursor: pointer;
      transition: all .2s ease;
      min-width: 0;
    }

    .pay-method-item:hover {
      background: #fff;
      border-color: var(--accent);
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(15, 23, 42, 0.10);
    }

    .p-icon {
      width: 44px; height: 44px;
      background: var(--accent-soft);
      border-radius: 12px;
      display: flex; align-items: center; justify-content: center;
      font-size: 21px;
      color: var(--accent);
      overflow: hidden;
      flex-shrink: 0;
    }

    .p-logo { width: 100%; height: 100%; object-fit: contain; padding: 8px; background: #fff; }

    .p-badge {
      width: 100%; height: 100%;
      display: flex; align-items: center; justify-content: center;
      font-size: 12px; font-weight: 800;
      letter-spacing: .2px; text-transform: uppercase;
    }

    .pb-dana { background: linear-gradient(135deg, #3b82f6, #0ea5e9); color: #fff; }
    .pb-ovo { background: linear-gradient(135deg, #a855f7, #6366f1); color: #fff; }
    .pb-shopeepay { background: linear-gradient(135deg, #f97316, #f43f5e); color: #fff; }
    .pb-linkaja { background: linear-gradient(135deg, #ef4444, #f43f5e); color: #fff; }
    .pb-gopay { background: linear-gradient(135deg, #22c55e, #10b981); color: #fff; }
    .pb-bank { background: linear-gradient(135deg, #334155, #1e293b); color: #e2e8f0; }

    .p-info { display: flex; flex-direction: column; min-width: 0; }
    .p-name { font-size: 14px; font-weight: 600; color: var(--text-main); }
    .p-sub { font-size: 12px; color: var(--text-muted); display: flex; flex-wrap: wrap; gap: 6px; }

    .p-chip {
      display: inline-flex; align-items: center;
      padding: 2px 8px;
      border-radius: 999px;
      border: 1px solid var(--card-border);
      background: #fff;
      color: var(--text-muted);
      font-size: 11px; font-weight: 700;
      line-height: 1.4; white-space: nowrap;
    }

    @media (max-width: 576px) {
      .pay-method-item { flex-direction: column; align-items: flex-start; gap: 10px; padding: 12px; }
      .p-sub { display: none; }
      .p-name { font-size: 13px; }
      .p-icon { width: 42px; height: 42px; font-size: 20px; }
    }

    .footer { text-align: center; padding: 30px 0 20px; color: var(--text-muted); }

    /* ===== WiFi Top Card ===== */
    .wifi-top-card {
      border-color: #bfdbfe;
      background: linear-gradient(135deg, #ffffff 0%, #f0f5ff 100%);
    }
    .wifi-top-card .card-header {
      background: transparent;
      border-bottom-color: #dbeafe;
      color: #1d4ed8;
    }
    .wifi-top-card .card-header i { color: #2563eb; }
    .wifi-top-card .btn-update {
      background: #2563eb;
    }
    .wifi-top-card .btn-update:hover { background: #1d4ed8; }

    #home-section, #billing-section, #ticket-section, #usage-section, #wifi-top-section {
      scroll-margin-top: 90px;
    }
  </style>
</head>

<body>
  <nav class="navbar shadow-sm">
    <div class="container d-flex justify-content-between align-items-center">
      <span class="navbar-brand d-flex align-items-center gap-2">
        <img src="/img/logo.png" alt="Logo"> <%= t('customer.dashboard.portal', 'Portal Pelanggan') %>
      </span>
      <div class="d-flex align-items-center gap-3">
        <span class="pelanggan-area d-none d-sm-inline">
          Pelanggan Area: <strong><%= profile ? profile.name : customer.phone %></strong>
        </span>
        <form method="POST" action="/customer/logout" class="d-inline mb-0">
          <button type="submit" class="btn-logout">
            <i class="bi bi-box-arrow-right me-1"></i>Log Out
          </button>
        </form>
      </div>
    </div>
  </nav>

  <div class="main-container">
    <div class="container">
      <% if (typeof notif !== 'undefined' && notif && notif.text) { %>
        <% var nClass = 'alert-' + (notif.type === 'danger' ? 'danger' : notif.type === 'warning' ? 'warning' : notif.type === 'info' ? 'info' : 'success'); %>
        <% var nIcon = notif.type === 'danger' || notif.type === 'warning' ? 'bi-exclamation-triangle' : notif.type === 'info' ? 'bi-info-circle' : 'bi-check-circle'; %>
        <div class="alert <%= nClass %> alert-dismissible fade show" role="alert" id="notif-alert">
          <i class="bi <%= nIcon %> me-2"></i>
          <%= notif.text %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% } %>

      <script>
        setTimeout(function () {
          var notif = document.getElementById('notif-alert');
          if (notif) notif.classList.remove('show');
        }, 4000);
      </script>

      <!-- ===== WiFi CARD (paling atas) ===== -->
      <div class="card mb-4 wifi-top-card" id="wifi-top-section">
        <div class="card-header">
          <i class="bi bi-wifi me-2"></i>Konfigurasi WiFi
          <% if (customer.ssid && customer.ssid !== '-') { %>
            <span class="badge bg-light text-dark ms-2" style="font-size:11px;font-weight:600;border:1px solid #e2e8f0;">
              <i class="bi bi-check-circle-fill text-success me-1" style="font-size:9px"></i>Terhubung
            </span>
          <% } %>
        </div>
        <div class="card-body">
          <form method="POST" action="/customer/change-ssid" id="wifiTopForm">
            <div class="row g-3 align-items-end">
              <div class="col-12 col-sm-5">
                <label class="form-label" for="wifiTopSsid">
                  <i class="bi bi-tag me-1"></i>Nama WiFi (SSID)
                </label>
                <div class="d-flex align-items-center gap-2">
                  <i class="bi bi-wifi" style="font-size:20px;color:var(--accent);flex-shrink:0"></i>
                  <input type="text" class="form-control" id="wifiTopSsid" name="ssid"
                    value="<%= customer.ssid !== '-' ? customer.ssid : '' %>"
                    placeholder="Nama WiFi baru" required maxlength="32">
                </div>
                <div class="stat-sub mt-1"><i class="bi bi-info-circle me-1"></i>5GHz otomatis menjadi <strong>&lt;SSID&gt;-5G</strong></div>
              </div>
              <div class="col-12 col-sm-5">
                <label class="form-label" for="wifiTopPass">
                  <i class="bi bi-lock me-1"></i>Password WiFi
                </label>
                <div class="input-group">
                  <span class="input-group-text bg-white" style="border-right:none;border-color:#cbd5e1">
                    <i class="bi bi-key" style="color:var(--text-muted)"></i>
                  </span>
                  <input type="password" class="form-control" id="wifiTopPass" name="wifi_password"
                    placeholder="Kosongkan jika tidak ingin ganti" minlength="8" maxlength="63"
                    autocomplete="off" data-lpignore="true" data-form-type="other"
                    style="border-left:none">
                  <button class="pass-toggle" type="button" id="wifiTopPassToggle" aria-label="Tampilkan password"
                    style="border:1px solid #cbd5e1;border-left:none;border-radius:0 10px 10px 0;background:#fff;padding:0 12px;color:var(--text-muted)">
                    <i class="bi bi-eye" id="wifiTopPassToggleIcon"></i>
                  </button>
                </div>
                <div class="stat-sub mt-1"><i class="bi bi-info-circle me-1"></i>Minimal 8 karakter. Kosongkan jika tidak diganti.</div>
              </div>
              <div class="col-12 col-sm-2">
                <button type="submit" class="btn-update w-100" style="padding:10px 12px;white-space:nowrap">
                  <i class="bi bi-check-lg me-1"></i>Simpan
                </button>
              </div>
            </div>
          </form>
        </div>
      </div>

      <!-- ===== 4 SUMMARY CARDS ===== -->
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-label"><i class="bi bi-broadcast me-1"></i>Status Koneksi</div>
          <div class="stat-value">
            <% if (customer.status === 'Online') { %>
              <span class="badge badge-soft-success"><i class="bi bi-circle-fill me-1" style="font-size:8px"></i>Normal</span>
            <% } else { %>
              <span class="badge badge-soft-danger"><i class="bi bi-circle-fill me-1" style="font-size:8px"></i>Gangguan / Offline</span>
            <% } %>
          </div>
          <% if (profile) { %>
            <div class="stat-sub">
              Layanan:
              <% if (profile.status === 'active') { %>
                <span class="badge badge-soft-success"><%= t('customer.dashboard.active', 'AKTIF') %></span>
              <% } else { %>
                <span class="badge badge-soft-danger"><%= t('customer.dashboard.suspended', 'ISOLIR') %></span>
              <% } %>
            </div>
          <% } %>
        </div>

        <div class="stat-card">
          <div class="stat-label"><i class="bi bi-person me-1"></i>Nama Pelanggan</div>
          <div class="stat-value"><%= profile ? profile.name : customer.phone %></div>
          <% if (profile) { %>
            <div class="stat-sub">ID: #<%= profile.id %></div>
          <% } %>
        </div>

        <div class="stat-card">
          <div class="stat-label"><i class="bi bi-upc-scan me-1"></i>Serial Number ONT</div>
          <div class="stat-value" style="font-size:14px"><%= customer.serialNumber || '-' %></div>
          <div class="stat-sub"><%= customer.model && customer.model !== '-' ? customer.model : (customer.productClass || '') %></div>
        </div>

        <div class="stat-card">
          <div class="stat-label"><i class="bi bi-wifi me-1"></i>Paket Internet</div>
          <div class="stat-value"><%= profile && profile.package_name ? profile.package_name : '-' %></div>
          <div class="stat-sub">
            <%= (typeof trafficMaxDownMbps !== 'undefined' ? trafficMaxDownMbps : 0) %> Mbps Down /
            <%= (typeof trafficMaxUpMbps !== 'undefined' ? trafficMaxUpMbps : 0) %> Mbps Up
          </div>
        </div>
      </div>

      <!-- ===== MAIN 2-COLUMN GRID ===== -->
      <div class="row g-4">

        <!-- ========== KOLOM KIRI ========== -->
        <div class="col-12 col-lg-6 order-2 order-lg-1">

          <!-- Card Informasi ONT -->
          <div class="card mb-4" id="home-section">
            <div class="card-header">
              <i class="bi bi-hdd-network me-2"></i>Informasi ONT
            </div>
            <div class="card-body pt-2">
              <div class="info-row">
                <span class="k">WAN IP Address</span>
                <span class="v"><%= customer.pppoeIP || '-' %></span>
              </div>
              <div class="info-row">
                <span class="k">Uptime ONT</span>
                <span class="v"><%= customer.uptime || '-' %></span>
              </div>
              <div class="info-row">
                <span class="k">Status Server ACS</span>
                <span class="v">
                  <% if (customer.status === 'Online') { %>
                    <span class="badge badge-soft-success">Terhubung</span>
                  <% } else { %>
                    <span class="badge badge-soft-secondary">Tidak Terhubung</span>
                  <% } %>
                  <div class="stat-sub">Inform terakhir: <%= customer.lastInform || '-' %></div>
                </span>
              </div>
              <div class="info-row">
                <span class="k">RX Power</span>
                <span class="v"><%= customer.rxPower || '-' %><%= customer.rxPower && !isNaN(parseFloat(customer.rxPower)) ? ' dBm' : '' %></span>
              </div>
              <div class="info-row">
                <span class="k">PPPoE Username</span>
                <span class="v"><%= customer.pppoeUsername || '-' %></span>
              </div>
              <div class="info-row">
                <span class="k">Nama SSID Saat Ini</span>
                <span class="v"><i class="bi bi-wifi me-1"></i><%= customer.ssid || '-' %></span>
              </div>

              <!-- Trafik realtime -->
              <div class="traffic-wrap">
                <div class="traffic-box">
                  <div class="stat-label mb-1">Trafik Download</div>
                  <div class="traffic-gauge">
                    <canvas id="pppoe_rx_gauge" width="240" height="150" data-max="<%= typeof trafficMaxDownMbps !== 'undefined' ? trafficMaxDownMbps : 10 %>"></canvas>
                    <div class="traffic-gauge-center">
                      <div class="traffic-gauge-value" id="pppoe_rx_value">-</div>
                      <div class="traffic-gauge-unit" id="pppoe_rx_unit">&nbsp;</div>
                    </div>
                  </div>
                  <div class="traffic-gauge-scale">
                    <span>0</span>
                    <span id="pppoe_rx_max"><%= typeof trafficMaxDownMbps !== 'undefined' ? trafficMaxDownMbps : 10 %> Mbps</span>
                  </div>
                </div>
                <div class="traffic-box">
                  <div class="stat-label mb-1">Trafik Upload</div>
                  <div class="traffic-gauge">
                    <canvas id="pppoe_tx_gauge" width="240" height="150" data-max="<%= typeof trafficMaxUpMbps !== 'undefined' ? trafficMaxUpMbps : 10 %>"></canvas>
                    <div class="traffic-gauge-center">
                      <div class="traffic-gauge-value" id="pppoe_tx_value">-</div>
                      <div class="traffic-gauge-unit" id="pppoe_tx_unit">&nbsp;</div>
                    </div>
                  </div>
                  <div class="traffic-gauge-scale">
                    <span>0</span>
                    <span id="pppoe_tx_max"><%= typeof trafficMaxUpMbps !== 'undefined' ? trafficMaxUpMbps : 10 %> Mbps</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Card Perangkat Terkoneksi -->
          <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
              <span><i class="bi bi-devices me-2"></i>Perangkat Terkoneksi</span>
              <span class="badge badge-soft-secondary"><%= connectedUsers ? connectedUsers.length : 0 %> perangkat</span>
            </div>
            <div class="card-body pt-2">
              <% if (connectedUsers && connectedUsers.length > 0) { %>
                <% connectedUsers.forEach(function(user) { %>
                  <div class="device-item">
                    <div class="device-icon">
                      <i class="bi <%= String(user.iface || '').toLowerCase().includes('wifi') || String(user.iface || '').toLowerCase().includes('802') ? 'bi-wifi' : 'bi-ethernet' %>"></i>
                    </div>
                    <div class="device-meta">
                      <div class="device-host"><%= user.hostname %></div>
                      <div class="device-sub"><%= user.ip %> &bull; <%= user.mac %></div>
                    </div>
                    <% if (user.status === 'Online') { %>
                      <span class="badge badge-soft-success">ACTIVE</span>
                    <% } else { %>
                      <span class="badge badge-soft-secondary">OFFLINE</span>
                    <% } %>
                  </div>
                <% }) %>
              <% } else { %>
                <div class="alert-netral p-3 mb-0 small">
                  <i class="bi bi-info-circle me-2"></i><%= t('customer.devices.empty', 'Tidak ada perangkat yang sedang terhubung.') %>
                </div>
              <% } %>
            </div>
          </div>

          <!-- Card Status WiFi (ringkas) -->
          <div class="card mb-4">
            <div class="card-header">
              <i class="bi bi-wifi me-2"></i>Status WiFi
            </div>
            <div class="card-body pt-2">
              <div class="info-row">
                <span class="k"><i class="bi bi-tag me-1"></i>Nama WiFi (SSID)</span>
                <span class="v"><i class="bi bi-wifi me-1"></i><%= customer.ssid !== '-' ? customer.ssid : '-' %></span>
              </div>
              <div class="info-row">
                <span class="k"><i class="bi bi-people me-1"></i>Perangkat Terkoneksi</span>
                <span class="v"><%= customer.totalAssociations !== undefined && customer.totalAssociations !== '-' ? customer.totalAssociations + ' perangkat' : '-' %></span>
              </div>
              <div class="mt-2 small text-muted">
                <i class="bi bi-arrow-up-circle me-1"></i>Ubah WiFi di menu paling atas halaman ini.
              </div>
            </div>
          </div>
        </div>

        <!-- ========== KOLOM KANAN ========== -->
        <div class="col-12 col-lg-6 order-1 order-lg-2">

          <!-- Card Tagihan -->
          <div class="card mb-4" id="billing-section">
            <div class="card-header">
              <i class="bi bi-receipt me-2"></i><%= t('customer.billing.title', 'Status Tagihan & Riwayat') %>
            </div>
            <div class="card-body">
              <% if (invoices && invoices.length > 0) { %>
                <% const monthNames = (typeof lang !== 'undefined' && lang === 'en') ? ['', 'January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'] : ['', 'Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember']; %>
                <% const paidInvoices = invoices.filter(i => i.status === 'paid'); %>
                <% const unpaidInvoices = invoices.filter(i => i.status !== 'paid'); %>
                <%
                  let paidThrough = null;
                  let paidYear = null;
                  let paidYearRanges = null;
                  if (paidInvoices.length > 0) {
                    paidInvoices.sort((a, b) => (a.period_year === b.period_year) ? (a.period_month - b.period_month) : (a.period_year - b.period_year));
                    const lastPaid = paidInvoices[paidInvoices.length - 1];
                    paidThrough = `${monthNames[lastPaid.period_month]} ${lastPaid.period_year}`;
                    paidYear = lastPaid.period_year;
                    const months = [...new Set(paidInvoices.filter(p => p.period_year === paidYear).map(p => p.period_month))].sort((a, b) => a - b);
                    const ranges = [];
                    if (months.length > 0) {
                      let s = months[0];
                      let p = months[0];
                      for (let i = 1; i < months.length; i++) {
                        const m = months[i];
                        if (m === p + 1) { p = m; continue; }
                        ranges.push([s, p]);
                        s = m; p = m;
                      }
                      ranges.push([s, p]);
                    }
                    paidYearRanges = ranges.map(([a, b]) => (a === b ? monthNames[a] : `${monthNames[a]}\u2013${monthNames[b]}`)).join(', ');
                  }
                %>
                <div class="mb-3" style="display:flex;flex-direction:column;gap:10px">
                  <% if (paidThrough) { %>
                    <div class="alert-lunas p-2 px-3 mb-0">
                      <i class="bi bi-shield-check me-2"></i><%= t('customer.billing.paid_through', 'Sudah lunas sampai') %>: <strong><%= paidThrough %></strong>
                      <% if (paidYear && paidYearRanges) { %>
                        <div class="small" style="opacity:.9;margin-top:4px"><%= t('customer.billing.paid_year_prefix', 'Sudah lunas tahun') %> <%= paidYear %>: <%= paidYearRanges %></div>
                      <% } %>
                    </div>
                  <% } else { %>
                    <div class="alert-netral p-2 px-3 mb-0">
                      <i class="bi bi-info-circle me-2"></i><%= t('customer.billing.none_paid', 'Belum ada tagihan yang lunas') %>
                    </div>
                  <% } %>
                  <% if (unpaidInvoices && unpaidInvoices.length > 0) { %>
                    <div class="alert-unpaid p-2 px-3 mb-0">
                      <i class="bi bi-exclamation-triangle me-2"></i><%= t('customer.billing.unpaid_summary_prefix', 'Masih ada') %> <strong><%= unpaidInvoices.length %></strong> <%= t('customer.billing.unpaid_summary_suffix', 'tagihan belum dibayar') %>
                    </div>
                  <% } %>
                </div>

                <div class="table-responsive">
                  <table class="table table-hover align-middle">
                    <thead>
                      <tr>
                        <th><%= t('customer.billing.period', 'Periode') %></th>
                        <th><%= t('customer.billing.amount', 'Jumlah') %></th>
                        <th><%= t('customer.billing.status', 'Status') %></th>
                      </tr>
                    </thead>
                    <tbody>
                      <% invoices.forEach(function(inv) { %>
                        <tr>
                          <td>
                            <strong><%= monthNames[inv.period_month] %> <%= inv.period_year %></strong>
                            <div class="text-muted small"><%= inv.package_name || t('customer.billing.internet_service', 'Layanan Internet') %></div>
                          </td>
                          <td>Rp <%= inv.amount.toLocaleString('id-ID') %></td>
                          <td>
                            <% if (inv.status === 'paid') { %>
                              <span class="badge badge-soft-success"><i class="bi bi-check-circle me-1"></i><%= t('customer.billing.paid', 'LUNAS') %></span>
                              <div class="text-muted small" style="font-size:10px"><%= t('customer.billing.paid_at', 'Dibayar') %>: <%= new Date(inv.paid_at).toLocaleDateString('id-ID') %></div>
                            <% } else { %>
                              <span class="badge badge-soft-danger"><i class="bi bi-exclamation-circle me-1"></i><%= t('customer.billing.unpaid', 'BELUM BAYAR') %></span>
                            <% } %>
                          </td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>

                <% if (unpaidInvoices && unpaidInvoices.length > 0) { %>
                  <div class="row g-2 mt-1">
                    <% unpaidInvoices.forEach(function(uinv) { %>
                      <div class="col-12 col-md-6">
                        <div class="pay-card">
                          <div class="d-flex justify-content-between align-items-start gap-2">
                            <div class="flex-grow-1">
                              <div class="fw-bold"><%= monthNames[uinv.period_month] %> <%= uinv.period_year %></div>
                              <div class="text-muted small"><%= uinv.package_name || t('customer.billing.internet_service', 'Layanan Internet') %></div>
                            </div>
                            <div class="text-end">
                              <div class="fw-bold">Rp <%= uinv.amount.toLocaleString('id-ID') %></div>
                            </div>
                          </div>
                          <button type="button" class="btn-bayar mt-3"
                            onclick="openPaymentModal('<%= uinv.id %>', '<%= uinv.amount %>')">
                            <i class="bi bi-wallet2 me-2"></i><%= t('customer.billing.pay_online', 'BAYAR ONLINE') %>
                          </button>
                        </div>
                      </div>
                    <% }) %>
                  </div>
                <% } %>
              <% } else { %>
                <p class="text-muted mb-0"><%= t('customer.billing.empty', 'Tidak ada data tagihan.') %></p>
              <% } %>
            </div>
          </div>

          <!-- Card Pemakaian Bulan Ini -->
          <div class="card mb-4" id="usage-section">
            <div class="card-header">
              <i class="bi bi-bar-chart me-2"></i>Pemakaian Bulan Ini
            </div>
            <div class="card-body">
              <%
                const usageInBytes = (profile && profile.bytes_in) ? Number(profile.bytes_in) : 0;
                const usageOutBytes = (profile && profile.bytes_out) ? Number(profile.bytes_out) : 0;
                const fmtGB = (b) => {
                  if (!b || b <= 0) return '0';
                  if (b >= 1073741824) return (b / 1073741824).toFixed(2);
                  return (b / 1048576).toFixed(0);
                };
                const fmtUnit = (b) => (b >= 1073741824 ? 'GB' : 'MB');
                const totalUsage = usageInBytes + usageOutBytes;
              %>
              <% if (totalUsage > 0) { %>
                <div class="d-flex justify-content-between align-items-end mb-3">
                  <div>
                    <div class="stat-label">Total Pemakaian</div>
                    <div style="font-size:26px;font-weight:800;line-height:1.1">
                      <%= fmtGB(totalUsage) %> <span style="font-size:14px;font-weight:600;color:var(--text-muted)"><%= fmtUnit(totalUsage) %></span>
                    </div>
                  </div>
                  <div class="text-end stat-sub">
                    <div><i class="bi bi-arrow-down-circle me-1" style="color:#2563eb"></i><%= fmtGB(usageInBytes) %> <%= fmtUnit(usageInBytes) %></div>
                    <div><i class="bi bi-arrow-up-circle me-1" style="color:#16a34a"></i><%= fmtGB(usageOutBytes) %> <%= fmtUnit(usageOutBytes) %></div>
                  </div>
                </div>
                <canvas id="usageChart" height="180"
                  data-in="<%= (usageInBytes / 1073741824).toFixed(3) %>"
                  data-out="<%= (usageOutBytes / 1073741824).toFixed(3) %>"></canvas>
              <% } else { %>
                <div class="alert-netral p-3 mb-0 small">
                  <i class="bi bi-info-circle me-2"></i>Belum ada data pemakaian yang tercatat untuk bulan ini. Data diperbarui berkala oleh sistem.
                </div>
              <% } %>
            </div>
          </div>

          <!-- Card Kontrol Sistem -->
          <div class="card mb-4">
            <div class="card-header">
              <i class="bi bi-toggles me-2"></i>Kontrol Sistem
            </div>
            <div class="card-body">
              <div class="ctrl-grid">
                <button type="button" id="rebootBtn" class="ctrl-btn danger"
                  data-confirm="<%= t('customer.reboot.confirm', 'Yakin ingin reboot perangkat Anda?') %>">
                  <i class="bi bi-arrow-repeat"></i>
                  <span>REBOOT</span>
                </button>
                <button type="button" id="refreshBtn" class="ctrl-btn primary"
                  data-confirm="Minta data terbaru dari perangkat (refresh parameter ACS)?">
                  <i class="bi bi-arrow-clockwise"></i>
                  <span>REFRESH</span>
                </button>
                <button type="button" class="ctrl-btn warning"
                  onclick="new bootstrap.Modal(document.getElementById('ticketModal')).show()">
                  <i class="bi bi-headset"></i>
                  <span>LAPORKAN GANGGUAN</span>
                </button>
              </div>
              <form id="rebootForm" method="POST" action="/customer/reboot" style="display:none;"></form>
              <form id="refreshForm" method="POST" action="/customer/refresh" style="display:none;"></form>
            </div>
          </div>

          <!-- Card Keamanan Akun -->
          <div class="card mb-4">
            <div class="card-header">
              <i class="bi bi-shield-lock me-2"></i>Keamanan Akun
            </div>
            <div class="card-body">
              <div class="info-row">
                <span class="k">ID Login Saat Ini</span>
                <span class="v"><%= customer.phone %></span>
              </div>
              <p class="text-muted small mt-2 mb-3">
                <i class="bi bi-info-circle me-1"></i>Login portal ini memakai kode OTP WhatsApp (tanpa password). Anda bisa mengganti ID/nomor login di bawah ini.
              </p>
              <form method="POST" action="/customer/change-tag" class="row g-2 align-items-center">
                <div class="col-12 col-md-8">
                  <input type="text" class="form-control" name="newTag" placeholder="ID / nomor login baru" required maxlength="32">
                </div>
                <div class="col-12 col-md-4">
                  <button class="btn-update w-100" type="submit">
                    <i class="bi bi-check-lg me-1"></i>Ganti ID Login
                  </button>
                </div>
              </form>
            </div>
          </div>

          <!-- Card Tiket Bantuan -->
          <div class="card mb-4" id="ticket-section">
            <div class="card-header d-flex justify-content-between align-items-center">
              <span><i class="bi bi-headset me-2"></i><%= t('customer.ticket.title', 'Tiket Bantuan & Keluhan') %></span>
              <button type="button" class="btn-update btn-sm" style="padding:6px 12px;font-size:12px"
                onclick="new bootstrap.Modal(document.getElementById('ticketModal')).show()">
                <i class="bi bi-plus-lg me-1"></i><%= t('customer.ticket.report_1', 'LAPORKAN') %>
              </button>
            </div>
            <div class="card-body">
              <% if (tickets && tickets.length > 0) { %>
                <div class="table-responsive">
                  <table class="table table-hover align-middle">
                    <thead>
                      <tr>
                        <th><%= t('customer.ticket.time', 'Waktu') %></th>
                        <th><%= t('customer.ticket.issue', 'Kendala') %></th>
                        <th><%= t('customer.ticket.status', 'Status') %></th>
                      </tr>
                    </thead>
                    <tbody>
                      <% tickets.forEach(function(ticket) { %>
                        <tr>
                          <td class="small">
                            <%= new Date(ticket.created_at).toLocaleString('id-ID', {dateStyle:'short', timeStyle:'short'}) %>
                          </td>
                          <td>
                            <strong><%= ticket.subject %></strong>
                            <div class="text-muted small text-truncate" style="max-width: 200px;"><%= ticket.message %></div>
                          </td>
                          <td>
                            <% if (ticket.status === 'open') { %>
                              <span class="badge badge-soft-danger"><i class="bi bi-exclamation-circle me-1"></i><%= t('customer.ticket.waiting', 'Menunggu') %></span>
                            <% } else if (ticket.status === 'in_progress') { %>
                              <span class="badge badge-soft-warning"><i class="bi bi-tools me-1"></i><%= t('customer.ticket.in_progress', 'Dikerjakan') %></span>
                            <% } else { %>
                              <span class="badge badge-soft-success"><i class="bi bi-check-circle me-1"></i><%= t('customer.ticket.resolved', 'Selesai') %></span>
                            <% } %>
                          </td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              <% } else { %>
                <p class="text-muted mb-0 small"><%= t('customer.ticket.empty', 'Belum ada riwayat keluhan.') %></p>
              <% } %>
            </div>
          </div>
        </div>
      </div>

      <div class="alert-netral p-3 mt-1 small">
        <i class="bi bi-info-circle me-2"></i>
        <%= t('customer.help.contact_admin', 'Jika mengalami kendala, silakan hubungi admin melalui WhatsApp.') %>
      </div>
    </div>
  </div>

  <footer class="footer">
    <div class="d-flex justify-content-center flex-wrap gap-3 mb-3">
      <a href="/customer/about" class="text-decoration-none text-muted small"><%= t('customer.footer.about', 'Tentang Kami') %></a>
      <a href="/customer/tos" class="text-decoration-none text-muted small"><%= t('customer.footer.tos', 'Ketentuan Layanan') %></a>
      <a href="/customer/privacy" class="text-decoration-none text-muted small"><%= t('customer.footer.privacy', 'Kebijakan Privasi') %></a>
      <a href="/customer/contact" class="text-decoration-none text-muted small"><%= t('customer.footer.contact', 'Kontak') %></a>
    </div>
    <div class="small opacity-75">
      &copy; <%= new Date().getFullYear() %>
        <%= settings.company_header || 'ALIJAYA DIGITAL NETWORK' %>
    </div>
  </footer>

  <!-- Modal Pilih Pembayaran -->
  <div class="modal fade" id="paymentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content pay-modal">
        <div class="modal-header border-0 pb-0" style="padding: 25px 25px 10px;">
          <h5 class="modal-title fw-bold"><i class="bi bi-wallet2 me-2" style="color:#2563eb"></i><%= t('customer.payment.choose_title', 'Pilih Pembayaran') %></h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body" style="padding: 10px 25px 30px;">
          <p class="text-muted small mb-4"><%= t('customer.payment.choose_desc', 'Silakan pilih metode pembayaran untuk tagihan sebesar') %> <strong
              id="pay_amount_text" style="color:#2563eb"></strong></p>

          <div class="payment-methods-grid">
            <% if (paymentChannels && paymentChannels.length > 0) { %>
              <!-- Dynamic Tripay Channels - Sorted by E-Wallet first -->
              <%
                const sortedChannels = [...paymentChannels].sort((a, b) => {
                  const priority = { 'E-Wallet': 1, 'QRIS': 2, 'Virtual Account': 3, 'Convenience Store': 4 };
                  const prioA = priority[a.group] || 99;
                  const prioB = priority[b.group] || 99;
                  return prioA - prioB;
                });

                sortedChannels.filter(c => c.active).forEach(channel => {
              %>
                <div class="pay-method-item" onclick="submitPayment('<%= channel.code %>')">
                  <div class="p-icon">
                    <%
                      const code = String(channel.code || '').toUpperCase();
                      const iconUrl = channel.icon_url || channel.iconUrl || '';
                      const brandMap = {
                        DANA: { label: 'DANA', cls: 'pb-dana' },
                        OVO: { label: 'OVO', cls: 'pb-ovo' },
                        SHOPEEPAY: { label: 'SP', cls: 'pb-shopeepay' },
                        LINKAJA: { label: 'LA', cls: 'pb-linkaja' },
                        GOPAY: { label: 'GoPay', cls: 'pb-gopay' }
                      };
                      let brand = null;
                      for (const k of Object.keys(brandMap)) {
                        if (code.includes(k)) { brand = brandMap[k]; break; }
                      }
                      const bankMap = {
                        BCAVA: 'BCA',
                        BNIVA: 'BNI',
                        BRIVA: 'BRI',
                        MANDIRIVA: 'Mandiri',
                        PERMATAVA: 'Permata',
                        CIMBVA: 'CIMB',
                        DANAMONVA: 'Danamon'
                      };
                      if (!brand && bankMap[code]) brand = { label: bankMap[code], cls: 'pb-bank' };
                      const nameMap = {
                        BCAVA: 'BCA VA',
                        BNIVA: 'BNI VA',
                        BRIVA: 'BRI VA',
                        MANDIRIVA: 'Mandiri VA',
                        PERMATAVA: 'Permata VA',
                        CIMBVA: 'CIMB VA',
                        DANAMONVA: 'Danamon VA',
                        QRIS: 'QRIS'
                      };
                      let shortName = nameMap[code] || String(channel.name || '').trim();
                      shortName = shortName
                        .replace(/virtual account/ig, 'VA')
                        .replace(/^bank\s+/ig, '')
                        .replace(/\s+/g, ' ')
                        .trim();
                      if (code !== 'QRIS' && code.includes('QRIS') && brand) shortName = `QRIS ${brand.label}`;
                      const group = String(channel.group || '');
                      const groupIcon =
                        group === 'Virtual Account' ? 'bi-bank2' :
                        group === 'E-Wallet' ? 'bi-wallet2' :
                        group === 'Convenience Store' ? 'bi-shop' :
                        'bi-qr-code-scan';
                      const shortGroup =
                        group === 'Virtual Account' ? 'VA' :
                        group === 'E-Wallet' ? 'E-Wallet' :
                        group === 'Convenience Store' ? 'CS' :
                        group === 'QRIS' ? 'QRIS' :
                        group;
                    %>
                    <% if (iconUrl) { %>
                      <img class="p-logo" src="<%= iconUrl %>" alt="<%= channel.name %>" loading="lazy" referrerpolicy="no-referrer">
                    <% } else if (brand) { %>
                      <span class="p-badge <%= brand.cls %>"><%= brand.label %></span>
                    <% } else { %>
                      <i class="bi <%= groupIcon %>"></i>
                    <% } %>
                  </div>
                  <div class="p-info">
                    <span class="p-name"><%= shortName %></span>
                    <span class="p-sub"><%= shortGroup %></span>
                  </div>
                </div>
              <% }) %>
            <% } else { %>
              <!-- Default Curated Methods (For Midtrans, Xendit, Duitku, or Tripay Fallback) -->

              <!-- E-Wallet / QRIS (Top Priority) -->
              <div class="pay-method-item" onclick="submitPayment('QRIS')">
                <div class="p-icon"><i class="bi bi-qr-code-scan"></i></div>
                <div class="p-info">
                  <span class="p-name">QRIS</span>
                  <span class="p-sub">
                    <span class="p-chip">DANA</span>
                    <span class="p-chip">OVO</span>
                    <span class="p-chip">ShopeePay</span>
                    <span class="p-chip">LinkAja</span>
                  </span>
                </div>
              </div>

              <!-- Virtual Accounts -->
              <div class="pay-method-item" onclick="submitPayment('MANDIRIVA')">
                <div class="p-icon"><i class="bi bi-bank"></i></div>
                <div class="p-info">
                  <span class="p-name">Mandiri VA</span>
                  <span class="p-sub">VA</span>
                </div>
              </div>

              <div class="pay-method-item" onclick="submitPayment('BRIVA')">
                <div class="p-icon"><i class="bi bi-bank"></i></div>
                <div class="p-info">
                  <span class="p-name">BRI VA</span>
                  <span class="p-sub">VA</span>
                </div>
              </div>

              <div class="pay-method-item" onclick="submitPayment('BNIVA')">
                <div class="p-icon"><i class="bi bi-bank"></i></div>
                <div class="p-info">
                  <span class="p-name">BNI VA</span>
                  <span class="p-sub">VA</span>
                </div>
              </div>

              <div class="pay-method-item" onclick="submitPayment('BCAVA')">
                <div class="p-icon"><i class="bi bi-bank"></i></div>
                <div class="p-info">
                  <span class="p-name">BCA VA</span>
                  <span class="p-sub">VA</span>
                </div>
              </div>

              <% const fallbackMethod = settings.default_gateway === 'midtrans' ? 'snap' : (settings.default_gateway === 'xendit' ? 'xendit' : 'duitku'); %>
              <div class="pay-method-item mt-2" data-method="<%= fallbackMethod %>"
                onclick="submitPayment(this.dataset.method)"
                style="background: #eff6ff; border-color: #93c5fd;">
                <div class="p-icon" style="background: #2563eb; color: white;"><i
                    class="bi bi-credit-card-2-back"></i></div>
                <div class="p-info">
                  <span class="p-name">Metode Lainnya</span>
                  <span class="p-sub">Pilih metode lain di halaman pembayaran</span>
                </div>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal Buat Tiket Keluhan -->
  <div class="modal fade" id="ticketModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content pay-modal">
        <div class="modal-header border-0 pb-0" style="padding: 25px 25px 10px;">
          <h5 class="modal-title fw-bold"><i class="bi bi-headset me-2" style="color:#2563eb"></i>Buat Tiket Keluhan</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <form method="POST" action="/customer/tickets/create">
          <div class="modal-body" style="padding: 10px 25px 20px;">
            <input type="hidden" name="customerId" value="<%= profile ? profile.id : '' %>">

            <div class="mb-3">
              <label class="form-label">Jenis Kendala</label>
              <select class="form-select" name="subject" required>
                <option value="">Pilih jenis kendala...</option>
                <option value="Internet Mati Total (LOS Merah)">Internet Mati Total (LOS Merah)</option>
                <option value="Internet Lambat / Sering Putus">Internet Lambat / Sering Putus</option>
                <option value="Lupa Password WiFi">Lupa Password WiFi</option>
                <option value="Lainnya">Lainnya</option>
              </select>
            </div>

            <div class="mb-3">
              <label class="form-label">Pesan / Detail</label>
              <textarea class="form-control" name="message" rows="3" required
                placeholder="Jelaskan detail kendala Anda di sini..."></textarea>
            </div>
          </div>
          <div class="modal-footer border-0" style="padding: 10px 25px 25px;">
            <button type="button" class="btn btn-light" data-bs-dismiss="modal"
              style="border-radius:10px;">Batal</button>
            <button type="submit" class="btn-update" style="border-radius:10px;">Kirim Keluhan</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script>
    let currentInvId = null;
    let pModal = null;

    document.addEventListener('DOMContentLoaded', () => {
      const modalEl = document.getElementById('paymentModal');
      if (modalEl) pModal = new bootstrap.Modal(modalEl);
    });

    function setTrafficText(el, text) {
      if (!el) return;
      el.innerText = text;
    }

    function niceMaxMbps(x) {
      const n = Number(x || 0);
      if (!Number.isFinite(n) || n <= 0) return 1;
      const exp = Math.floor(Math.log10(n));
      const base = n / Math.pow(10, exp);
      const steps = [1, 2, 5, 10];
      let chosen = steps[steps.length - 1];
      for (const s of steps) {
        if (base <= s) { chosen = s; break; }
      }
      return chosen * Math.pow(10, exp);
    }

    function formatRate(mbps) {
      const n = Number(mbps || 0);
      if (!Number.isFinite(n) || n <= 0) return { valueText: '0', unitText: 'Kbps' };
      if (n >= 1) return { valueText: n.toFixed(2), unitText: 'Mbps' };
      const kbps = n * 1000;
      return { valueText: String(Math.round(kbps)), unitText: 'Kbps' };
    }

    function drawSemiGauge(canvas, ratio, colorA, colorB) {
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;
      const w = canvas.width;
      const h = canvas.height;
      const cx = w / 2;
      const cy = h * 0.92;
      const radius = Math.min(w * 0.42, h * 0.72);
      const start = Math.PI;
      const end = Math.PI * 2;
      const line = Math.max(10, Math.round(Math.min(w, h) * 0.07));

      const clamped = Math.max(0, Math.min(1, Number(ratio) || 0));

      ctx.clearRect(0, 0, w, h);
      ctx.lineCap = 'round';
      ctx.lineWidth = line;

      ctx.beginPath();
      ctx.strokeStyle = 'rgba(100, 116, 139, 0.18)';
      ctx.arc(cx, cy, radius, start, end);
      ctx.stroke();

      if (clamped > 0) {
        const grad = ctx.createLinearGradient(cx - radius, cy, cx + radius, cy);
        grad.addColorStop(0, colorA);
        grad.addColorStop(1, colorB);
        ctx.beginPath();
        ctx.strokeStyle = grad;
        const a = start + (end - start) * clamped;
        ctx.arc(cx, cy, radius, start, a);
        ctx.stroke();

        const px = cx + radius * Math.cos(a);
        const py = cy + radius * Math.sin(a);
        ctx.beginPath();
        ctx.fillStyle = '#ffffff';
        ctx.arc(px, py, line * 0.55, 0, Math.PI * 2);
        ctx.fill();
        ctx.beginPath();
        ctx.fillStyle = colorB;
        ctx.arc(px, py, line * 0.35, 0, Math.PI * 2);
        ctx.fill();
      }
    }

    const trafficGaugeState = {
      rx: { maxMbps: 10, current: 0, target: 0, canvasId: 'pppoe_rx_gauge', maxId: 'pppoe_rx_max', valueId: 'pppoe_rx_value', unitId: 'pppoe_rx_unit', c1: '#3b82f6', c2: '#06b6d4' },
      tx: { maxMbps: 10, current: 0, target: 0, canvasId: 'pppoe_tx_gauge', maxId: 'pppoe_tx_max', valueId: 'pppoe_tx_value', unitId: 'pppoe_tx_unit', c1: '#22c55e', c2: '#a3e635' }
    };

    function setGauge(kind, mbps, labelOverride) {
      const st = trafficGaugeState[kind];
      if (!st) return;
      if (typeof labelOverride === 'string' && labelOverride) {
        const vEl = document.getElementById(st.valueId);
        const uEl = document.getElementById(st.unitId);
        setTrafficText(vEl, labelOverride);
        setTrafficText(uEl, '');
        st.target = 0;
        return;
      }
      const n = Number(mbps || 0);
      const safe = Number.isFinite(n) ? Math.max(0, n) : 0;
      st.target = safe;
      const maxEl = document.getElementById(st.maxId);
      if (maxEl) maxEl.innerText = `${st.maxMbps} Mbps`;
      const { valueText, unitText } = formatRate(safe);
      setTrafficText(document.getElementById(st.valueId), valueText);
      setTrafficText(document.getElementById(st.unitId), unitText);
    }

    function renderGauges() {
      const gamma = 0.55;
      for (const kind of ['rx', 'tx']) {
        const st = trafficGaugeState[kind];
        const d = st.target - st.current;
        st.current = st.current + d * 0.22;
        if (Math.abs(d) < 0.001) st.current = st.target;
        const linear = st.maxMbps > 0 ? (st.current / st.maxMbps) : 0;
        const clamped = Math.max(0, Math.min(1, linear));
        const ratio = clamped > 0 ? Math.pow(clamped, gamma) : 0;
        const canvas = document.getElementById(st.canvasId);
        drawSemiGauge(canvas, ratio, st.c1, st.c2);
      }
      requestAnimationFrame(renderGauges);
    }

    async function refreshPppoeTraffic() {
      const rxCanvas = document.getElementById('pppoe_rx_gauge');
      const txCanvas = document.getElementById('pppoe_tx_gauge');
      if (!rxCanvas || !txCanvas) return;
      try {
        const r = await fetch('/customer/api/pppoe-traffic', { cache: 'no-store' });
        const data = await r.json();
        if (!data || !data.ok) {
          setGauge('rx', 0, 'Error');
          setGauge('tx', 0, 'Error');
          return;
        }
        if (data.available === false) {
          setGauge('rx', 0, 'N/A');
          setGauge('tx', 0, 'N/A');
          return;
        }
        if (!data.online) {
          setGauge('rx', 0, 'Offline');
          setGauge('tx', 0, 'Offline');
          return;
        }
        if (data.warmup) {
          setGauge('rx', 0, 'Mengukur');
          setGauge('tx', 0, 'Mengukur');
          return;
        }
        const rx = Number(data.rxMbps || 0);
        const tx = Number(data.txMbps || 0);
        setGauge('rx', tx);
        setGauge('tx', rx);
      } catch {
        setGauge('rx', 0, '-');
        setGauge('tx', 0, '-');
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      const rxCanvas = document.getElementById('pppoe_rx_gauge');
      const txCanvas = document.getElementById('pppoe_tx_gauge');
      const rxMaxEl = document.getElementById('pppoe_rx_max');
      const txMaxEl = document.getElementById('pppoe_tx_max');
      const rxMax = Number(rxCanvas && rxCanvas.dataset ? rxCanvas.dataset.max : 10);
      const txMax = Number(txCanvas && txCanvas.dataset ? txCanvas.dataset.max : 10);
      trafficGaugeState.rx.maxMbps = Number.isFinite(rxMax) && rxMax > 0 ? rxMax : 10;
      trafficGaugeState.tx.maxMbps = Number.isFinite(txMax) && txMax > 0 ? txMax : 10;
      if (rxMaxEl) rxMaxEl.innerText = `${trafficGaugeState.rx.maxMbps} Mbps`;
      if (txMaxEl) txMaxEl.innerText = `${trafficGaugeState.tx.maxMbps} Mbps`;

      requestAnimationFrame(renderGauges);
      refreshPppoeTraffic();
      setInterval(refreshPppoeTraffic, 3000);
    });

    function openPaymentModal(invId, amount) {
      currentInvId = invId;
      document.getElementById('pay_amount_text').innerText = 'Rp ' + parseInt(amount).toLocaleString('id-ID');
      if (pModal) pModal.show();
    }

    function submitPayment(method) {
      if (!currentInvId) return;
      window.location.href = `/customer/payment/create/${currentInvId}?method=${method}`;
    }

    // Kontrol Sistem: REBOOT & REFRESH dengan konfirmasi
    document.addEventListener('DOMContentLoaded', () => {
      const rebootBtn = document.getElementById('rebootBtn');
      if (rebootBtn) {
        rebootBtn.addEventListener('click', function (e) {
          e.preventDefault();
          if (confirm(this.dataset.confirm || 'Yakin?')) {
            document.getElementById('rebootForm').submit();
          }
        });
      }
      const refreshBtn = document.getElementById('refreshBtn');
      if (refreshBtn) {
        refreshBtn.addEventListener('click', function (e) {
          e.preventDefault();
          if (confirm(this.dataset.confirm || 'Refresh data?')) {
            document.getElementById('refreshForm').submit();
          }
        });
      }
    });

    // Toggle visibility password WiFi
    document.addEventListener('DOMContentLoaded', () => {
      // Bottom card (old)
      const inp1 = document.getElementById('wifiPassInput');
      const tgl1 = document.getElementById('wifiPassToggle');
      const ico1 = document.getElementById('wifiPassToggleIcon');
      if (inp1 && tgl1 && ico1) {
        tgl1.addEventListener('click', function () {
          const show = inp1.type === 'password';
          inp1.type = show ? 'text' : 'password';
          ico1.className = show ? 'bi bi-eye-slash' : 'bi bi-eye';
        });
      }
      // Top card (new)
      const inp2 = document.getElementById('wifiTopPass');
      const tgl2 = document.getElementById('wifiTopPassToggle');
      const ico2 = document.getElementById('wifiTopPassToggleIcon');
      if (inp2 && tgl2 && ico2) {
        tgl2.addEventListener('click', function () {
          const show = inp2.type === 'password';
          inp2.type = show ? 'text' : 'password';
          ico2.className = show ? 'bi bi-eye-slash' : 'bi bi-eye';
        });
      }
    });

    // Bar chart pemakaian bulanan
    document.addEventListener('DOMContentLoaded', () => {
      const el = document.getElementById('usageChart');
      if (!el || typeof Chart === 'undefined') return;
      const inGB = Number(el.dataset.in || 0);
      const outGB = Number(el.dataset.out || 0);
      new Chart(el.getContext('2d'), {
        type: 'bar',
        data: {
          labels: ['Download', 'Upload'],
          datasets: [{
            data: [inGB, outGB],
            backgroundColor: ['rgba(37, 99, 235, 0.85)', 'rgba(22, 163, 74, 0.85)'],
            borderRadius: 10,
            maxBarThickness: 70
          }]
        },
        options: {
          responsive: true,
          plugins: {
            legend: { display: false },
            tooltip: {
              callbacks: {
                label: (ctx) => ` ${Number(ctx.raw).toFixed(2)} GB`
              }
            }
          },
          scales: {
            y: {
              beginAtZero: true,
              title: { display: true, text: 'GB', color: '#64748b', font: { size: 11 } },
              grid: { color: 'rgba(100, 116, 139, 0.12)' },
              ticks: { color: '#64748b', font: { size: 11 } }
            },
            x: {
              grid: { display: false },
              ticks: { color: '#0f172a', font: { size: 12, weight: '600' } }
            }
          }
        }
      });
    });
  </script>

  <script>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js', { scope: '/customer/' }).catch(() => {});
      });
    }
  </script>
  <%- include('partials/customer_bottom_nav', { activeNav: 'home' }) %>
</body>

</html>
